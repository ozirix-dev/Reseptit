{
  "name": "reseptit-static-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "content:sync": "tsx scripts/build-content.ts",
    "test": "node scripts/run-unit-tests.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "audit:c5-market-labels": "tsx scripts/c5-market-label-audit.ts",
    "audit:bakwan-v2": "tsx scripts/bakwan-v2-candidate-calculation.ts",
    "audit:c5-drafts": "tsx scripts/c-five-draft-version-gate.ts",
    "audit:scenario-c5": "tsx scripts/c-five-variant-scenarios.ts",
    "audit:product-c5": "tsx scripts/bakwan-jianbing-product-evidence.ts",
    "audit:c-five": "tsx scripts/c-five-nutrition-recheck.ts",
    "audit:material15": "tsx scripts/material-fifteen-evidence-check.ts",
    "preflight:source": "tsx scripts/source-migration-preflight.ts",
    "test:nutrition": "tsx --test tests/nutrition-model.test.ts tests/nutrition-evidence.test.ts",
    "test:glycemic": "tsx --test tests/glycemic-load.test.ts tests/glycemic-coverage-inventory.test.ts",
    "test:select-ci": "node --test scripts/select-ci-checks.test.mjs",
    "validate:changed-content": "tsx scripts/validate-changed-content.ts",
    "test:translations": "tsx --test tests/translations.test.ts tests/translation-review.test.ts tests/translation-batch-partition.test.ts tests/translation-publication-index.test.ts tests/f25-source-release-gate.test.ts",
    "test:image": "tsx --test --test-concurrency=1 tests/image-pipeline.test.ts",
    "test:browser": "node scripts/run-browser-suites.mjs \"smoke ui routes images\"",
    "test:static": "tsx --test tests/static-output.test.ts tests/seo-audit.test.ts tests/blog.test.ts tests/navigation.test.ts",
    "build": "npm run content:sync && npm run audit:nutrition -- --strict && npm run audit:glycemic-load && npm run typecheck && vite build && tsx scripts/prerender.ts",
    "preview": "vite preview --host 127.0.0.1",
    "report:inventory": "npm run content:sync && tsx scripts/inventory.ts",
    "audit:seo": "tsx scripts/seo-audit.ts",
    "audit:seo:public": "tsx scripts/seo-public.ts",
    "nutrition:batch": "tsx scripts/nutrition-batch-builder.ts",
    "audit:nutrition": "tsx scripts/nutrition-audit.ts",
    "audit:glycemic-load": "tsx scripts/glycemic-load-pilot.ts",
    "audit:glycemic-coverage": "tsx scripts/glycemic-coverage-inventory.ts",
    "review:translations": "tsx scripts/translation-review.ts",
    "queue:translations": "tsx scripts/translation-queue-cli.ts",
    "pilot:gk149": "tsx scripts/gk149-pilot.ts",
    "pilot:gk149-recovery": "tsx scripts/gk149-recovery.ts",
    "pilot:gk149-prepared-route": "tsx scripts/gk149-prepared-route.ts",
    "gk:approval-check": "tsx scripts/gk100-approval-cli.ts",
    "test:gk100-approval": "tsx --test tests/gk100-approval-factory.test.ts",
    "audit:similarity": "tsx scripts/recipe-similarity-report.ts",
    "audit:assistant": "tsx scripts/assistant-offline-eval.ts",
    "audit:assistant:language-review": "tsx scripts/assistant-language-review.ts",
    "test:c20-fi-editorial": "tsx --test tests/c20-fi-editorial-display.test.ts",
    "test:d30-fi-mint": "tsx --test tests/d30-fi-mint-milk-display.test.ts",
    "test:fi-breakfast-quality": "tsx --test tests/fi-breakfast-quality-display.test.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.2.1",
    "marked": "^18.1.3",
    "playwright": "^1.65.0",
    "sharp": "0.35.5",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  }
}

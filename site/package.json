{
  "name": "reseptit-static-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "content:sync": "tsx scripts/build-content.ts",
    "test": "npm run content:sync && tsx --test tests/servings.test.ts tests/published-content.test.ts tests/markdown-safety.test.ts tests/recipe-schema.test.ts",
    "test:image": "tsx --test --test-concurrency=1 tests/image-pipeline.test.ts",
    "test:browser": "tsx --test --test-concurrency=1 tests/browser-smoke.test.ts",
    "test:static": "tsx --test tests/static-output.test.ts",
    "build": "npm run content:sync && tsc -p tsconfig.json && vite build && tsx scripts/prerender.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "marked": "^17.0.5",
    "playwright": "^1.64.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  }
}

{
  "name": "reseptit-static-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "content:sync": "tsx scripts/build-content.ts",
    "test": "tsx --test tests/servings.test.ts tests/published-content.test.ts tests/markdown-safety.test.ts tests/recipe-schema.test.ts tests/recipe-search.test.ts tests/route-content.test.ts tests/nutrition-model.test.ts tests/nutrition-evidence.test.ts tests/glycemic-load.test.ts tests/glycemic-coverage-inventory.test.ts scripts/changed-content-checks.test.ts tests/gk80-release2.test.ts tests/gk80-source-classification.test.ts tests/gk80-release.test.ts tests/gk80-integration.test.ts tests/gk80-display.test.ts tests/gk80-food-safety.test.ts",
    "test:nutrition": "tsx --test tests/nutrition-model.test.ts tests/nutrition-evidence.test.ts",
    "test:glycemic": "tsx --test tests/glycemic-load.test.ts tests/glycemic-coverage-inventory.test.ts",
    "test:select-ci": "node --test scripts/select-ci-checks.test.mjs",
    "validate:changed-content": "tsx scripts/validate-changed-content.ts",
    "test:translations": "tsx --test tests/translations.test.ts tests/translation-review.test.ts",
    "test:image": "tsx --test --test-concurrency=1 tests/image-pipeline.test.ts",
    "test:browser": "tsx --test --test-concurrency=1 tests/browser-smoke.test.ts tests/route-loading.browser.test.ts tests/responsive-images.browser.test.ts",
    "test:static": "tsx --test tests/static-output.test.ts tests/seo-audit.test.ts",
    "build": "npm run content:sync && npm run audit:nutrition -- --strict && npm run audit:glycemic-load && tsc -p tsconfig.json && vite build && tsx scripts/prerender.ts",
    "preview": "vite preview --host 127.0.0.1",
    "report:inventory": "npm run content:sync && tsx scripts/inventory.ts",
    "audit:seo": "tsx scripts/seo-audit.ts",
    "audit:seo:public": "tsx scripts/seo-public.ts",
    "nutrition:batch": "tsx scripts/nutrition-batch-builder.ts",
    "audit:nutrition": "tsx scripts/nutrition-audit.ts",
    "audit:glycemic-load": "tsx scripts/glycemic-load-pilot.ts",
    "audit:glycemic-coverage": "tsx scripts/glycemic-coverage-inventory.ts",
    "review:translations": "tsx scripts/translation-review.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "marked": "^18.1.1",
    "playwright": "^1.64.1",
    "sharp": "0.35.5",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  }
}

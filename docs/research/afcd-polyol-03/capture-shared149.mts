import fs from 'node:fs/promises';import path from 'node:path';import {pathToFileURL} from 'node:url';import {createHash} from 'node:crypto';import {execFileSync} from 'node:child_process';
const root=path.resolve(process.argv[2]),stage=path.resolve(process.argv[3]),scratch=path.resolve(process.argv[4]);let parent=scratch;while(true){try{parent=await fs.realpath(parent);break;}catch(e:any){if(e.code!=='ENOENT')throw e;parent=path.dirname(parent);}}try{execFileSync('git',['rev-parse','--show-toplevel'],{cwd:parent,stdio:'ignore'});throw Error('External non-Git scratch output required');}catch(e:any){if(e.status!==128)throw e;}await fs.mkdir(scratch,{recursive:true});
const manifest:any={capturedAt:new Date().toISOString(),stageOnly:true,files:{}};
for(const rel of ['docs/nutrition/gk80-operation149/cases.json','docs/nutrition/gk80-operation149/composition-sources.json','docs/nutrition/gk80-operation149/gi-sources.json','docs/nutrition/gk80-operation149/source-observations.json','docs/nutrition/gk80-operation149/method-proposal.md','site/scripts/gk149-model.ts','docs/nutrition/gk80-operation149/hold-screen.csv','docs/nutrition/gk80-operation149/recipe-decisions.json','docs/nutrition/gk80-operation149/next30.json']){const bytes=await fs.readFile(path.join(stage,rel));await fs.writeFile(path.join(scratch,path.basename(rel)),bytes);manifest.files[rel]=createHash('sha256').update(bytes).digest('hex');}
for(const [rel,expected] of Object.entries(manifest.files)){const actual=createHash('sha256').update(await fs.readFile(path.join(stage,rel))).digest('hex');if(actual!==expected)throw Error('Concurrent source edit: '+rel);}
let model=await fs.readFile(scratch+'/gk149-model.ts','utf8');model=model.replace("from './glycemic-load-model'",'from '+JSON.stringify(pathToFileURL(root+'/site/scripts/glycemic-load-model.ts').href));await fs.writeFile(scratch+'/model-runner.mts',model);
const {evaluate,summarize}=await import(pathToFileURL(scratch+'/model-runner.mts').href);
const pack=JSON.parse(await fs.readFile(scratch+'/cases.json','utf8')),comps=JSON.parse(await fs.readFile(scratch+'/composition-sources.json','utf8')).records,gis=JSON.parse(await fs.readFile(scratch+'/gi-sources.json','utf8')).records;
const results=pack.cases.map((c:any)=>evaluate(c,comps,gis));
await fs.writeFile(scratch+'/results.json',JSON.stringify({summary:summarize(results),results},null,2)+'\n');await fs.writeFile(scratch+'/manifest.json',JSON.stringify(manifest,null,2)+'\n');
console.log(JSON.stringify({summary:summarize(results),cases:results.map((r:any)=>({id:r.recipeId,level:r.level,numeric:r.numericProposal,point:r.point,range:r.scenarioRange,blockers:r.blockers})),compositions:comps.filter((c:any)=>c.kind==='AFCD_WITHOUT_SUGAR_ALCOHOLS').map((c:any)=>({id:c.id,a:c.availablePer100g,nativeId:c.nativeId}))},null,2));

import {readFileSync} from 'node:fs';
import {pathToFileURL} from 'node:url';
import {createHash} from 'node:crypto';
import path from 'node:path';
const root=path.resolve(process.argv[2]);const dir=path.resolve(process.argv[3]??import.meta.dirname);
const read=(p:string)=>JSON.parse(readFileSync(p,'utf8'));
const manifest=read(path.join(dir,'source-manifest.json'));
for(const [p,h] of Object.entries(manifest.sourceLfSha256))if(createHash('sha256').update(readFileSync(path.join(root,p),'utf8').replace(/\r\n/g,'\n')).digest('hex')!==h)throw Error('SOURCE_CHANGED '+p);
const catalog=read(path.join(dir,'source-catalog.json'));const bundle=read(path.join(dir,'proposal.json'));
const foods=Object.values(catalog.foods);const gi=Object.values(catalog.existingGiCards);
const {calculateGlycemicLoad}=await import(pathToFileURL(path.join(root,'site/scripts/glycemic-load-model.ts')).href);
const input={recipeId:bundle.recipeId,servings:bundle.servings,ingredients:bundle.ingredients};
const result=calculateGlycemicLoad(input,foods,gi);
if(result.status!=='CALCULATED'||Math.abs(result.unroundedGlycemicLoadPerServing-0.4356)>1e-12||Math.abs(result.omittedAvailableCarbohydratePerServingG-1.6284125)>1e-12)throw Error(JSON.stringify(result));
const controls:any[]=[];
const reject=(label:string,change:(x:any)=>void)=>{const x=structuredClone(input);change(x);const r=calculateGlycemicLoad(x,foods,gi);if(r.status!=='INSUFFICIENT SOURCE DATA')throw Error('UNSAFE '+label);controls.push({label,status:r.status,blockers:r.blockers});};
reject('Unspecified sausage cannot inherit Tammelan label',x=>{delete x.ingredients[0].availableCarbohydrateUpperBoundPerServingG;delete x.ingredients[0].upperBoundEvidence;});
reject('Harkatien lenkki1.7 label yields2.125g, exceeds individual1g',x=>x.ingredients[0].availableCarbohydrateUpperBoundPerServingG=2.125);
reject('Unweighed pepper not zero',x=>x.ingredients[7].grams=null);
reject('Dropping onion GI gives2.2884125g cumulative omission',x=>x.ingredients[2].giRecordId=null);
reject('Unknown Dijon brand cannot inherit named label',x=>{delete x.ingredients[3].availableCarbohydrateUpperBoundPerServingG;delete x.ingredients[3].upperBoundEvidence;});
reject('Exact individual1g allowance is blocked',x=>x.ingredients[0].availableCarbohydrateUpperBoundPerServingG=1);
console.log(JSON.stringify({researchOnly:true,sourceApplicationApproved:false,publicationApproved:false,newPublishedValue:false,recipeId:input.recipeId,all8SourceRowsPresent:input.ingredients.length===8,result,negativeControls:controls,display:'alle5',displayIsNotConfidenceInterval:true},null,2));
